discovery.docker "rev_eval" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = [
      "com.docker.compose.project=rev-eval",
      "com.docker.compose.project=observability",
    ]
  }
}

discovery.relabel "rev_eval" {
  targets = discovery.docker.rev_eval.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "rev_eval" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.rev_eval.output
  forward_to = [loki.process.json.receiver]
}

loki.process "json" {
  // Strip ANSI colour codes from startup/init lines before JSON parsing.
  stage.decolorize {}

  // Extract fields from JSON log lines; non-JSON lines pass through unscathed.
  stage.json {
    expressions = { level = "level", correlation_id = "correlation_id" }
  }

  // level is bounded-cardinality — safe as a label.
  stage.labels {
    values = { level = "" }
  }

  // correlation_id is high-cardinality — store as structured metadata, never a label.
  stage.structured_metadata {
    values = { correlation_id = "" }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
