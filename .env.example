# ------------------------------------------------------------------------------
# JWT (shared between user-service and api-gateway)
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ------------------------------------------------------------------------------
# PostgreSQL (docker-compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=eval_ai_dev

# ------------------------------------------------------------------------------
# MongoDB (docker-compose)
# ------------------------------------------------------------------------------
MONGO_USER=admin
MONGODB_PASSWORD=admin
MONGO_DB=evalai

# ------------------------------------------------------------------------------
# MinIO / S3 (docker-compose; AWS S3-compatible)
# ------------------------------------------------------------------------------
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=question-images
# Browser-reachable MinIO endpoint for signing pre-signed upload/GET URLs.
# Internal service-to-service ops use S3_ENDPOINT_URL (minio:9000) instead.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Comma-separated origins allowed to POST uploads directly to MinIO (browser).
MINIO_CORS_ORIGINS=http://localhost:3000
