# ==============================================================================
# Local development example. Copy to .env: `cp .env.example .env`
#
# SECURITY: the values below are LOCAL-DEV DEFAULTS ONLY. For any shared,
# staging, or production-like environment you MUST replace every secret/password
# with a strong, unique value and set ALLOW_INSECURE_DEV_SECRETS=false.
# ==============================================================================

# ------------------------------------------------------------------------------
# JWT (shared between user-service and api-gateway)
# ------------------------------------------------------------------------------
# JWT_SECRET must be a strong, random value of at least JWT_MIN_SECRET_LENGTH
# characters. The services FAIL TO START on a missing/placeholder/short secret
# unless ALLOW_INSECURE_DEV_SECRETS=true. Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=rev-eval-user-service
JWT_AUDIENCE=rev-eval-clients
JWT_MIN_SECRET_LENGTH=32
# Local-dev escape hatch: permits the weak default JWT_SECRET above. Set to
# false (or remove) everywhere except local development.
ALLOW_INSECURE_DEV_SECRETS=true

# ------------------------------------------------------------------------------
# Internal service-to-service auth
# ------------------------------------------------------------------------------
# Shared secret presented by test-management on direct calls to user-service so
# they pass user-service's admin-guarded read endpoints. The gateway strips any
# client-supplied X-Internal-Key, so this is never accepted from outside the
# Docker network. Use a strong unique value outside local dev.
INTERNAL_API_KEY=local-dev-internal-key

# ------------------------------------------------------------------------------
# PostgreSQL (docker-compose) — published on 127.0.0.1 only
# ------------------------------------------------------------------------------
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=eval_ai_dev

# ------------------------------------------------------------------------------
# MongoDB (docker-compose) — published on 127.0.0.1 only
# ------------------------------------------------------------------------------
MONGO_USER=admin
MONGODB_PASSWORD=admin
MONGO_DB=evalai

# ------------------------------------------------------------------------------
# MinIO / S3 (docker-compose; AWS S3-compatible) — published on 127.0.0.1 only
# ------------------------------------------------------------------------------
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=question-images

# ------------------------------------------------------------------------------
# Grafana (observability) — published on 127.0.0.1 only
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# test-management-service → optional service integrations
# ------------------------------------------------------------------------------
# Interview transcript/evaluation service. Leave empty to disable: review flows
# then skip transcript fetch / evaluation push instead of failing.
INTERVIEW_SERVICE_URL=
