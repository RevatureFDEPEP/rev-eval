# ------------------------------------------------------------------------------
# JWT (shared between user-service and api-gateway)
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ------------------------------------------------------------------------------
# PostgreSQL (docker-compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=eval_ai_dev

# ------------------------------------------------------------------------------
# MongoDB (docker-compose)
# ------------------------------------------------------------------------------
MONGO_USER=admin
MONGODB_PASSWORD=admin
MONGO_DB=evalai

# ------------------------------------------------------------------------------
# MinIO / S3 (docker-compose; AWS S3-compatible)
# ------------------------------------------------------------------------------
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=question-images
# Browser-resolvable MinIO endpoint used when signing pre-signed URLs
# (SigV4 binds the Host header; http://minio:9000 only resolves in-network)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Origin allowed to PUT directly to MinIO from the browser
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Observability (JSON logging level for backend services)
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
